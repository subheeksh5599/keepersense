{
  "buildCommand": "cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api", "destination": "/api/proxy" },
    { "source": "/api/(.*)", "destination": "/api/proxy" }
  ],
  "functions": {
    "api/proxy.py": { "maxDuration": 15, "memory": 512 }
  }
}
